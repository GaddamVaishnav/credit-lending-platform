# Copy this to .env and fill in your values
# Never commit .env to Git — it's in .gitignore

# JWT (generate with: openssl rand -base64 32)
JWT_SECRET=bXlTdXBlclNlY3JldEtleUZvckpXVFRva2VuR2VuZXJhdGlvbjEyMzQ1

# Database
DB_USERNAME=credit_user
DB_PASSWORD=credit_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Eureka
EUREKA_URL=http://localhost:8761/eureka

# AWS S3
AWS_S3_BUCKET=credit-platform-documents
AWS_REGION=ap-south-1
AWS_ACCESS_KEY=your_aws_access_key_here
AWS_SECRET_KEY=your_aws_secret_key_here

# SendGrid (email)
SENDGRID_API_KEY=SG.your_sendgrid_key_here

# Twilio (SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Razorpay (payment gateway)
RAZORPAY_KEY=rzp_test_your_key_here
RAZORPAY_SECRET=your_razorpay_secret_here

# MongoDB
MONGODB_URI=mongodb://localhost:27017/credit_notifications
